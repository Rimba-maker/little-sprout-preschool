---
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource-variable/figtree';
import '@fontsource-variable/shantell-sans';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/primitives.css';
import '../styles/sections.css';
import { programs } from '../data/content';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Little Sprout Preschool — Preschool & TK Reggio Emilia Montessori Jakarta',
  description = 'Preschool & TK dengan kurikulum Reggio Emilia + Montessori. Anak 2-6 tahun. Bilingual ID-EN, ECCD certified teachers, akreditasi A. Jakarta, BSD, Surabaya.',
} = Astro.props;

const site = Astro.site?.toString().replace(/\/$/, '') ?? 'https://littlesprout.id';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': ['Preschool', 'EducationalOrganization'],
      '@id': `${site}/#school`,
      name: 'Little Sprout Preschool',
      url: site,
      description,
      slogan: 'Where Little Minds Grow Curious.',
      email: 'hello@littlesprout.id',
      sameAs: ['https://instagram.com/littlesprout.id'],
      areaServed: ['Jakarta Selatan', 'BSD Serpong', 'Surabaya'],
      image: `${site}/og.jpg`,
      hasCourse: programs.map((p) => ({
        '@type': 'Course',
        name: p.name,
        description: `Program usia ${p.age}. ${p.focus}. Rasio guru ${p.ratio}.`,
        provider: { '@id': `${site}/#school` },
      })),
    },
  ],
};
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="preschool jakarta, TK montessori, reggio emilia jakarta, preschool BSD, TK bilingual jakarta, daycare premium, kindergarten jakarta" />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#141b40" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={site + '/'} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Little Sprout Preschool" />
    <meta property="og:description" content="Where Little Minds Grow Curious. Preschool & TK bilingual, Reggio Emilia + Montessori." />
    <meta property="og:image" content={`${site}/og.jpg`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip" href="#filosofi">Lewati ke konten</a>
    <slot />
    <script>
      import '../scripts/ui.ts';
    </script>
  </body>
</html>
