---
import { photo } from '../../data/photos';
import { curriculum } from '../../data/content';
---
<section class="board" data-board="teal" id="kurikulum" aria-labelledby="curr-title">
  <div class="wrap">
    <div class="board-head" data-reveal>
      <h2 id="curr-title">Kurikulum Kami</h2>
      <p>Bukan kurikulum cookie-cutter. Kombinasi pendekatan terbaik untuk early childhood.</p>
    </div>
    <div class="index">
      {curriculum.map((c, i) => {
        const ph = photo(c.photo);
        return (
          <article class="index__item" data-reveal style={`--i:${i}`}>
            <img src={ph.src} alt={ph.alt} width="1000" height="750" loading="lazy" />
            <h3>{c.title}</h3>
            <p>{c.body}</p>
          </article>
        );
      })}
    </div>
  </div>
</section>
