---
import Icon from '../ui/Icon.astro';
import { photo } from '../../data/photos';
import { facilities, safety } from '../../data/content';
---
<section class="board" data-board="clay" id="fasilitas" aria-labelledby="fac-title">
  <div class="wrap">
    <div class="board-head" data-reveal>
      <h2 id="fac-title">Lingkungan Yang Mendukung Tumbuh Kembang</h2>
    </div>
    <div class="contact">
      {facilities.map((f, i) => {
        const ph = photo(f.photo);
        return (
          <article class="fac" data-reveal style={`--i:${i % 3}`}>
            <img src={ph.src} alt={ph.alt} width="1200" height="800" loading="lazy" />
            <h3>{f.title}</h3>
            <ul>{f.points.map((p) => <li>{p}</li>)}</ul>
          </article>
        );
      })}
    </div>
    <div class="safety" data-reveal>
      <h3>Keamanan</h3>
      <ul>{safety.map((s) => <li><Icon name="check" />{s}</li>)}</ul>
    </div>
  </div>
</section>
