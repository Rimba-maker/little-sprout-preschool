---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/sections/Nav.astro';
import Hero from '../components/sections/Hero.astro';
import Philosophy from '../components/sections/Philosophy.astro';
import Programs from '../components/sections/Programs.astro';
import Curriculum from '../components/sections/Curriculum.astro';
import Day from '../components/sections/Day.astro';
import Teachers from '../components/sections/Teachers.astro';
import Facilities from '../components/sections/Facilities.astro';
import Moments from '../components/sections/Moments.astro';
import Tuition from '../components/sections/Tuition.astro';
import Testimonials from '../components/sections/Testimonials.astro';
import Tour from '../components/sections/Tour.astro';
import FaqSection from '../components/sections/FaqSection.astro';
import Booking from '../components/sections/Booking.astro';
import Footer from '../components/sections/Footer.astro';
import PageThread from '../components/islands/PageThread';
---
<BaseLayout>
  <Nav />
  <PageThread client:idle />
  <main>
    <Hero />
    <Philosophy />
    <Programs />
    <Curriculum />
    <Day />
    <Teachers />
    <Facilities />
    <Moments />
    <Tuition />
    <Testimonials />
    <Tour />
    <FaqSection />
    <Booking />
  </main>
  <Footer />
</BaseLayout>
